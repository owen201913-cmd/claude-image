{
  "name": "ngini-image-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude Image: unofficial local Ngini image generation for Claude Desktop",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsc && tsc --project tsconfig.ui.json && node scripts/build-ui.mjs",
    "test": "vitest run",
    "start": "node dist/bootstrap.js",
    "package": "node scripts/package.mjs",
    "test:protocol": "node scripts/protocol-smoke.mjs",
    "verify:release": "node scripts/release-audit.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.3.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright-core": "1.62.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "npm": "12.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@11.19.0"
}
